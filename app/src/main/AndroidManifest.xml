<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- S0 실측 권한 (qa/S0-probe.md) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 쉿 모드 앰비언트 밝기 쓰기 : SDK LightImpl은 CONTROL_CAR_LIGHTS를 요구한다) -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 정차 중 "말로 입력" (Pleos SpeechToText) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 화면이 가려져도 운전을 계속 느끼도록 세션을 포그라운드 서비스로 유지 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".PikoApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <meta-data android:name="distractionOptimized" android:value="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- 주행 중에도 표시 가능 (UX 제한 시 앱이 스스로 터치·텍스트를 끈다) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 뒷좌석 화면 (아이용). 보조 디스플레이에 따로 뜨는 태스크 -->
        <activity
            android:name=".rear.RearActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:taskAffinity="com.pikodrive.rear"
            android:launchMode="singleTask">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
        <service
            android:name=".PikoDriveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="In-car companion that reacts to live vehicle signals (gear, speed, battery) while other apps such as navigation are in the foreground" />
        </service>
    </application>
</manifest>
